#!/usr/bin/expect -f

if {$argc != 3} {
  puts stderr "usage: qemu-tests.exp QEMU KERNEL_IMAGE FS_IMAGE"
  exit 2
}

set qemu [lindex $argv 0]
set kernel [lindex $argv 1]
set fs [lindex $argv 2]
set timeout 120
set cpus 2
if {[info exists env(XV6_CPUS)]} {
  set cpus $env(XV6_CPUS)
}
set test_filter ""
if {[info exists env(XV6_TEST_FILTER)]} {
  set test_filter $env(XV6_TEST_FILTER)
}

proc should_run {command} {
  global test_filter
  if {$test_filter eq ""} {
    return 1
  }
  set id [string map {" " "-"} $command]
  return [expr {$test_filter eq $id}]
}

spawn $qemu -nographic \
  -drive file=$fs,index=1,media=disk,format=raw \
  -drive file=$kernel,index=0,media=disk,format=raw \
  -smp $cpus -m 512
expect {
  "init: starting sh" {}
  timeout { puts stderr "QEMU boot timed out"; exit 1 }
  eof { puts stderr "QEMU exited during boot"; exit 1 }
}

proc run_test {command marker} {
  if {![should_run $command]} {
    return
  }
  send -- "$command\r"
  expect {
    -exact $marker { puts "PASS $command" }
    -re {_LEAK|_BAD|X(SPEC|IO|NESTED) FAIL|panic:|^FAIL} {
      puts stderr "Guest reported failure while running $command"
      exit 1
    }
    timeout {
      puts stderr "Timed out waiting for '$marker' from $command"
      exit 1
    }
    eof {
      puts stderr "QEMU exited before '$marker' from $command"
      exit 1
    }
  }
}

proc run_ordered_test {command first second done forbidden} {
  if {![should_run $command]} {
    return
  }
  send -- "$command\r"
  expect {
    -exact $forbidden {
      puts stderr "Output '$forbidden' escaped before '$first' in $command"
      exit 1
    }
    -exact $first {}
    -re {_LEAK|_BAD|X(SPEC|IO|NESTED) FAIL|panic:|^FAIL} {
      puts stderr "Guest reported failure while running $command"
      exit 1
    }
    timeout {
      puts stderr "Timed out waiting for '$first' from $command"
      exit 1
    }
    eof {
      puts stderr "QEMU exited before '$first' from $command"
      exit 1
    }
  }
  expect {
    -exact $second {}
    -re {_LEAK|_BAD|X(SPEC|IO|NESTED) FAIL|panic:|^FAIL} {
      puts stderr "Guest reported failure while running $command"
      exit 1
    }
    timeout {
      puts stderr "Timed out waiting for '$second' from $command"
      exit 1
    }
    eof {
      puts stderr "QEMU exited before '$second' from $command"
      exit 1
    }
  }
  expect {
    -exact $done { puts "PASS $command" }
    -re {_LEAK|_BAD|X(SPEC|IO|NESTED) FAIL|panic:|^FAIL} {
      puts stderr "Guest reported failure while running $command"
      exit 1
    }
    timeout {
      puts stderr "Timed out waiting for '$done' from $command"
      exit 1
    }
    eof {
      puts stderr "QEMU exited before '$done' from $command"
      exit 1
    }
  }
}

run_test "xspec" "XSPEC PASS (filesystem isolation and lifecycle)"
run_test "xnested" "XNESTED PASS (nested merge and abort)"
run_ordered_test "xexec" "EXEC_PRECOMMIT" "EXEC_CHILD_OUTPUT" "EXEC_COMMIT_DONE" "EXEC_CHILD_OUTPUT"
run_test "xio console-abort" "CONSOLE_ABORT_DONE"
run_ordered_test "xio console-commit" "CONSOLE_COMMIT_OBSERVER" "CONSOLE_COMMIT_PAYLOAD" "CONSOLE_COMMIT_DONE" "CONSOLE_COMMIT_PAYLOAD"
run_test "xio console-cap" "CONSOLE_CAPACITY_OK"
run_test "xio pipe-same" "PIPE_SAME_DONE"
run_ordered_test "xio pipe-commit" "PIPE_COMMIT_MARK" "OUTSIDE_PIPE_C" "PIPE_COMMIT_DONE" "OUTSIDE_PIPE_C"
run_test "xio pipe-abort" "PIPE_ABORT_DONE"
run_test "xio pipe-wrap" "PIPE_WRAP_OK"
run_test "xio pipe-full" "PIPE_FULL_DONE"
run_test "xio pipe-full-abort" "PIPE_FULL_ABORT_DONE"
run_test "xio pipe-mixed" "PIPE_MIXED_DONE"
run_test "xio pipe-multi-writer" "PIPE_MULTI_WRITER_DONE"
run_test "xio pipe-reader-exit" "PIPE_READER_EXIT_DONE"
run_test "xio pipe-ordinary" "PIPE_ORDINARY_OK"
run_test "xio pipe-blocked-commit" "PIPE_BLOCKED_COMMIT_DRAINED"
run_test "xio pipe-blocked-abort" "PIPE_BLOCKED_ABORT_DRAINED"
run_test "xio owner-exit" "OWNER_EXIT_OBSERVER"
run_test "xio child-abort" "CHILD_ABORT_DONE"
set timeout 900
run_test "usertests" "ALL TESTS PASSED"

send -- "\001x"
expect eof
set qemu_result [wait]
set qemu_status [lindex $qemu_result 3]
if {$qemu_status != 0} {
  puts stderr "QEMU exited with status $qemu_status after the test suite"
  exit 1
}
puts "PASS qemu-shutdown"
