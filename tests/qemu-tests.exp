#!/usr/bin/expect -f

if {$argc != 3} {
  puts stderr "usage: qemu-tests.exp QEMU KERNEL_IMAGE FS_IMAGE"
  exit 2
}

set qemu [lindex $argv 0]
set kernel [lindex $argv 1]
set fs [lindex $argv 2]
set timeout 120

spawn $qemu -nographic \
  -drive file=$fs,index=1,media=disk,format=raw \
  -drive file=$kernel,index=0,media=disk,format=raw \
  -smp 2 -m 512
expect {
  "init: starting sh" {}
  timeout { puts stderr "QEMU boot timed out"; exit 1 }
  eof { puts stderr "QEMU exited during boot"; exit 1 }
}

proc run_test {command marker} {
  send -- "$command\r"
  expect {
    -exact $marker { puts "PASS $command" }
    -re {X(SPEC|IO|NESTED) FAIL|panic:|^FAIL} {
      puts stderr "Guest reported failure while running $command"
      exit 1
    }
    timeout {
      puts stderr "Timed out waiting for '$marker' from $command"
      exit 1
    }
    eof {
      puts stderr "QEMU exited before '$marker' from $command"
      exit 1
    }
  }
}

run_test "xspec" "XSPEC PASS (filesystem isolation and lifecycle)"
run_test "xnested" "XNESTED PASS (nested merge and abort)"
run_test "xio console-abort" "CONSOLE_ABORT_DONE"
run_test "xio console-commit" "CONSOLE_COMMIT_DONE"
run_test "xio console-cap" "CONSOLE_CAPACITY_OK"
run_test "xio pipe-same" "PIPE_SAME_DONE"
run_test "xio pipe-commit" "PIPE_COMMIT_DONE"
run_test "xio pipe-abort" "PIPE_ABORT_DONE"
run_test "xio pipe-wrap" "PIPE_WRAP_OK"
run_test "xio pipe-full" "PIPE_FULL_DONE"
run_test "xio pipe-full-abort" "PIPE_FULL_ABORT_DONE"
run_test "xio pipe-mixed" "PIPE_MIXED_DONE"
run_test "xio pipe-ordinary" "PIPE_ORDINARY_OK"
run_test "xio pipe-blocked-commit" "PIPE_BLOCKED_COMMIT_DRAINED"
run_test "xio pipe-blocked-abort" "PIPE_BLOCKED_ABORT_DRAINED"
run_test "xio owner-exit" "OWNER_EXIT_OBSERVER"
run_test "xio child-abort" "CHILD_ABORT_DONE"

send -- "\001x"
expect eof
wait
